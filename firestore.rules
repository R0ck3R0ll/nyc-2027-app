rules_version = '2';
// App del viaje a Nueva York 2027
//  - trips/{viaje}: el id es largo y aleatorio y solo lo tiene quien ha recibido el enlace de invitación;
//    no se pueden listar los viajes.
//  - blocks: programa · claims: quién ha entrado con cada nombre (uno por nombre) · notifs: avisos de cambios
// Todos entran con acceso anónimo de Firebase (sin cuentas).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // En una escritura por lotes (crear el viaje con sus bloques) el viaje existe «después» del lote
    function tripAfter(t) { return existsAfter(/databases/$(database)/documents/trips/$(t)); }
    function isOrganizer(t) {
      return exists(/databases/$(database)/documents/trips/$(t)/claims/carlo)
        && get(/databases/$(database)/documents/trips/$(t)/claims/carlo).data.uid == request.auth.uid;
    }

    match /trips/{t} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && t.size() >= 20 && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']);
      allow delete: if false;

      match /blocks/{id} {
        allow read: if signedIn();
        allow create, update: if signedIn() && tripAfter(t)
          && id.size() <= 40
          && request.resource.data.day is int && request.resource.data.day >= 1 && request.resource.data.day <= 7
          && request.resource.data.start is string && request.resource.data.start.size() <= 5
          && request.resource.data.who in ['all', 'A', 'B']
          && request.resource.data.keys().hasOnly(['id', 'day', 'start', 'dur', 'who', 'type', 'n', 'title', 'note', 'status', 'fixed', 'place', 'booking', 'by', 'at']);
        allow delete: if signedIn() && tripAfter(t);
      }
      // Un nombre de la lista solo puede estar en un móvil. Se reserva si está libre (o liberado);
      // solo el organizador (Carlo) puede liberarlo poniendo uid a null.
      match /claims/{key} {
        allow read: if signedIn();
        allow create: if signedIn() && tripAfter(t) && key.size() <= 20
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'at']);
        allow update: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
          && ((resource.data.uid == null && request.resource.data.uid == request.auth.uid)
              || (request.resource.data.uid == null && isOrganizer(t)));
        allow delete: if false;
      }
      match /notifs/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && tripAfter(t) && id.size() <= 40
          && request.resource.data.keys().hasOnly(['id', 'at', 'by', 'byFam', 'who', 'txt', 'day', 'blockId'])
          && request.resource.data.txt is string && request.resource.data.txt.size() <= 500
          && request.resource.data.who in ['all', 'A', 'B'];
        allow update, delete: if false;
      }
    }
  }
}
